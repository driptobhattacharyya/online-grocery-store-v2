# Copy to .env. Demo defaults are fine for a local portfolio run.

FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_EXPIRES_HOURS=12

DATABASE_PATH=instance/grocery.db
SEED_DEMO_DATA=1

# SimpleCache works with no Redis. Docker Compose sets RedisCache.
CACHE_TYPE=SimpleCache
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=3

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set true only for tests or a single-process demo. Leave unset when a worker is running.
CELERY_TASK_ALWAYS_EAGER=false

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=grocery-store@localhost

ADMIN_EMAIL=admin@grocery.local
ADMIN_PASSWORD=admin123
MANAGER_EMAIL=manager@grocery.local
MANAGER_PASSWORD=manager123
CUSTOMER_EMAIL=customer@grocery.local
CUSTOMER_PASSWORD=customer123

# Leave blank to use the local TF-IDF search and ingredient matcher.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_USE_EMBEDDINGS=1

VUE_APP_API_BASE=
VUE_APP_PROXY_TARGET=http://localhost:5000
